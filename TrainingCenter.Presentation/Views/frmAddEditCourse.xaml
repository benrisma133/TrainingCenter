<Window x:Class="TrainingCenter.Presentation.Views.frmAddEditCourse"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:inputs="clr-namespace:TrainingCenter.Presentation.Controls"
        Title="Add Course"
        Width="560" Height="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        Loaded="Window_Loaded">

    <Grid Margin="8">
        <Border CornerRadius="16"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource BorderDefaultBrush}"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="20"
                                  ShadowDepth="0" Opacity="0.5"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="55"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="70"/>
                </Grid.RowDefinitions>

                <!-- HEADER -->
                <Border Grid.Row="0"
                        CornerRadius="16,16,0,0"
                        Background="{StaticResource SidebarBackgroundBrush}"
                        MouseDown="Header_MouseDown">
                    <Grid Margin="16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="{StaticResource AccentBrush}"
                                    CornerRadius="8" Width="30" Height="30"
                                    Margin="0,0,10,0">
                                <TextBlock Text="C" FontSize="14" FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="FormTitle"
                                       Text="Add New Course"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Width="30" Height="30"
                                BorderThickness="0" Cursor="Hand"
                                Click="CloseBtn_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background"
                                                    Value="{StaticResource ErrorLightBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <Viewbox Width="14" Height="14">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M18 6L6 18M6 6L18 18"
                                          Stroke="{StaticResource TextSecondaryBrush}"
                                          StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </Grid>
                </Border>

                <!-- CONTENT -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              Padding="24,16">
                    <StackPanel>

                        <TextBlock x:Name="FormSubtitle"
                                   Text="Fill in the details below to add a new course"
                                   FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,0,0,16"/>

                        <!-- ERROR BOX -->
                        <Border x:Name="ErrorBox"
                                Background="{StaticResource ErrorLightBrush}"
                                BorderBrush="{StaticResource ErrorBrush}"
                                BorderThickness="1" CornerRadius="8"
                                Padding="14,10" Margin="0,0,0,16"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="⚠️ Please fix the following errors:"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource ErrorBrush}"
                                           FontSize="13" Margin="0,0,0,6"/>
                                <TextBlock x:Name="ErrorText"
                                           Foreground="{StaticResource ErrorBrush}"
                                           FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- SUCCESS BOX -->
                        <Border x:Name="SuccessBox"
                                Background="{StaticResource SuccessLightBrush}"
                                BorderBrush="{StaticResource SuccessBrush}"
                                BorderThickness="1" CornerRadius="8"
                                Padding="14,10" Margin="0,0,0,16"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="✓ Success!"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource SuccessBrush}"
                                           FontSize="13" Margin="0,0,0,4"/>
                                <TextBlock Text="Course saved successfully."
                                           Foreground="{StaticResource SuccessBrush}"
                                           FontSize="12"/>
                            </StackPanel>
                        </Border>

                        <!-- Title + Code -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <inputs:ModernInput x:Name="TxtTitle"
                                                Grid.Column="0"
                                                Label="Course Title"
                                                Placeholder="C# Fundamentals"/>
                            <inputs:ModernInput x:Name="TxtCode"
                                                Grid.Column="2"
                                                Label="Code"
                                                Placeholder="CSH101"/>
                        </Grid>

                        <!-- Description -->
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="Description (optional)"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,0,6"/>
                            <Border Background="{StaticResource InputBackgroundBrush}"
                                    BorderBrush="{StaticResource BorderDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8">
                                <TextBox x:Name="TxtDescription"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="{StaticResource TextPrimaryBrush}"
                                         FontSize="13"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         Height="80"
                                         Padding="10,8"
                                         VerticalScrollBarVisibility="Auto"
                                         CaretBrush="{StaticResource AccentBrush}"/>
                            </Border>
                        </StackPanel>

                        <!-- Price + Duration -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <inputs:ModernInput x:Name="TxtPrice"
                                                Grid.Column="0"
                                                Label="Price ($)"
                                                Placeholder="99.99"/>
                            <inputs:ModernInput x:Name="TxtDuration"
                                                Grid.Column="2"
                                                Label="Duration (hours)"
                                                Placeholder="20"/>
                        </Grid>

                        <!-- Level -->
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="Level"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,0,6"/>
                            <ComboBox x:Name="LevelCombo"
                                      Style="{StaticResource DarkComboBox}"
                                      ItemContainerStyle="{StaticResource DarkComboBoxItem}">
                                <ComboBoxItem Content="Beginner"     Tag="Beginner"/>
                                <ComboBoxItem Content="Intermediate" Tag="Intermediate"/>
                                <ComboBoxItem Content="Advanced"     Tag="Advanced"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Status -->
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="Status"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,0,6"/>
                            <ComboBox x:Name="StatusCombo"
                                      Style="{StaticResource DarkComboBox}"
                                      ItemContainerStyle="{StaticResource DarkComboBoxItem}">
                                <ComboBoxItem Content="Draft"    Tag="Draft"/>
                                <ComboBoxItem Content="Active"   Tag="Active"/>
                                <ComboBoxItem Content="Archived" Tag="Archived"/>
                                <ComboBoxItem Content="Closed"   Tag="Closed"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Instructor -->
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="Instructor"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,0,6"/>
                            <ComboBox x:Name="InstructorCombo"
                                      Style="{StaticResource DarkComboBox}"
                                      ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                                      DisplayMemberPath="Content"/>
                        </StackPanel>

                        <!-- Published Date -->
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="Published Date (optional)"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,0,6"/>
                            <DatePicker x:Name="PublishedPicker"
                                        Style="{StaticResource DarkDatePicker}"/>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>

                <!-- FOOTER -->
                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,20,0">
                    <Button Content="Cancel"
                            Width="120" Height="40"
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,0,10,0"
                            Click="CancelBtn_Click"/>
                    <Button x:Name="SaveBtn"
                            Content="Save Course"
                            Width="140" Height="40"
                            Style="{StaticResource PrimaryButton}"
                            Click="SaveBtn_Click"/>
                </StackPanel>

            </Grid>
        </Border>
    </Grid>
</Window>