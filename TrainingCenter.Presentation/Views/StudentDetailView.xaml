<UserControl x:Class="TrainingCenter.Presentation.Views.StudentDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource AppBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR -->
        <Border Grid.Row="0"
                Background="{StaticResource HeaderBackgroundBrush}"
                BorderBrush="{StaticResource BorderDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Back Button -->
                <Button Grid.Column="0"
                        BorderThickness="0"
                        Background="Transparent"
                        Cursor="Hand"
                        Click="BackBtn_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="Transparent"
                                    CornerRadius="8"
                                    Padding="10,6">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="16" Height="16" Margin="0,0,8,0">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M19 12H5M5 12L12 19M5 12L12 5"
                                                  Stroke="{StaticResource AccentBrush}"
                                                  StrokeThickness="2" Fill="Transparent"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="All Students"
                                               FontSize="13"
                                               Foreground="{StaticResource AccentBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background"
                                            Value="{StaticResource AccentLightBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Edit Button -->
                <Button Grid.Column="2"
                        Content="Edit Student"
                        Style="{StaticResource PrimaryButton}"
                        Width="130"
                        Click="EditBtn_Click"/>
            </Grid>
        </Border>

        <!-- CONTENT -->
        <ScrollViewer Grid.Row="1"
              VerticalScrollBarVisibility="Auto"
              HorizontalScrollBarVisibility="Disabled"
              HorizontalContentAlignment="Stretch"
              Padding="24,20">
            <StackPanel HorizontalAlignment="Stretch">

                <!-- PROFILE HEADER CARD -->
                <Border Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource BorderDefaultBrush}"
                        BorderThickness="1" CornerRadius="12"
                        Padding="24" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Avatar -->
                        <Border Width="72" Height="72" CornerRadius="36"
                                Background="{StaticResource AccentLightBrush}"
                                Margin="0,0,20,0">
                            <TextBlock x:Name="AvatarText"
                                       FontSize="28" FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <!-- Name + Email + Phone -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="FullNameText"
                                       FontSize="22" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="EmailText" FontSize="14"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Margin="0,4,0,0"/>
                            <TextBlock x:Name="PhoneText" FontSize="14"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Status Badge -->
                        <Border x:Name="StatusBadge" Grid.Column="2"
                                CornerRadius="8" Padding="14,6"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="StatusText"
                                       FontSize="13" FontWeight="SemiBold"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- PERSONAL INFO -->
                <TextBlock Text="Personal Information"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,0,10"/>

                <Border Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource BorderDefaultBrush}"
                        BorderThickness="1" CornerRadius="12"
                        Padding="24" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Date of Birth" FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Margin="0,0,0,4"/>
                            <TextBlock x:Name="DobText" FontSize="14"
                                       FontWeight="Medium"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Age" FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Margin="0,0,0,4"/>
                            <TextBlock x:Name="AgeText" FontSize="14"
                                       FontWeight="Medium"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Registered At" FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Margin="0,0,0,4"/>
                            <TextBlock x:Name="RegisteredText" FontSize="14"
                                       FontWeight="Medium"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- PROFILE INFO -->
                <TextBlock Text="Profile"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,0,10"/>

                <Border Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource BorderDefaultBrush}"
                        BorderThickness="1" CornerRadius="12"
                        Padding="24" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Column="0" Grid.Row="0">
                            <TextBlock Text="City" FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Margin="0,0,0,4"/>
                            <TextBlock x:Name="CityText" FontSize="14"
                                       FontWeight="Medium"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Grid.Row="0">
                            <TextBlock Text="Country" FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Margin="0,0,0,4"/>
                            <TextBlock x:Name="CountryText" FontSize="14"
                                       FontWeight="Medium"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Grid.Row="0">
                            <TextBlock Text="LinkedIn" FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Margin="0,0,0,4"/>
                            <TextBlock x:Name="LinkedInText" FontSize="14"
                                       FontWeight="Medium"
                                       Foreground="{StaticResource AccentBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <Border Grid.Row="1" Grid.ColumnSpan="3"
                                Height="1"
                                Background="{StaticResource BorderDefaultBrush}"
                                VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="3">
                            <TextBlock Text="Bio" FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Margin="0,0,0,4"/>
                            <TextBlock x:Name="BioText" FontSize="14"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ENROLLMENTS -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Enrollments"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <Border Background="{StaticResource AccentLightBrush}"
                            CornerRadius="10" Padding="8,2"
                            Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="EnrollmentCountText"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}"/>
                    </Border>
                </StackPanel>

                <Border Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource BorderDefaultBrush}"
                        BorderThickness="1" CornerRadius="12"
                        Padding="8" Margin="0,0,0,24">
                    <StackPanel x:Name="EnrollmentsPanel"/>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>