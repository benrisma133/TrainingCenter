<Window x:Class="TrainingCenter.Presentation.Views.frmAddEditStudent"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:inputs="clr-namespace:TrainingCenter.Presentation.Controls"
        Title="Add Student"
        Width="520" Height="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource AppBackgroundBrush}"
        Loaded="Window_Loaded">

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel Grid.Row="0">
            <TextBlock x:Name="FormTitle"
                       Text="Add New Student"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock x:Name="FormSubtitle"
                       Text="Fill in the details below to add a new student"
                       FontSize="13"
                       Foreground="{StaticResource TextMutedBrush}"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <!-- FORM FIELDS -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <!-- First Name + Last Name -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <inputs:ModernInput x:Name="TxtFirstName"
                                        Grid.Column="0"
                                        Label="First Name"
                                        Placeholder="Ahmed"/>

                    <inputs:ModernInput x:Name="TxtLastName"
                                        Grid.Column="2"
                                        Label="Last Name"
                                        Placeholder="Hassan"/>
                </Grid>

                <!-- Email -->
                <inputs:ModernInput x:Name="TxtEmail"
                                    Label="Email Address"
                                    Placeholder="ahmed@example.com"
                                    Margin="0,0,0,16"/>

                <!-- Phone -->
                <inputs:ModernInput x:Name="TxtPhone"
                                    Label="Phone Number"
                                    Placeholder="+212 6XX XXX XXX"
                                    Margin="0,0,0,16"/>

                <!-- Date of Birth -->
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="Date of Birth"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,8"/>
                    <Border Background="{StaticResource InputBackgroundBrush}"
                            BorderBrush="{StaticResource BorderDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Height="46">
                        <DatePicker x:Name="DobPicker"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="{StaticResource TextPrimaryBrush}"
                                    FontSize="14"
                                    VerticalAlignment="Center"
                                    Padding="8,0"/>
                    </Border>
                </StackPanel>

                <!-- Status -->
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="Status"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,8"/>
                    <Border Background="{StaticResource InputBackgroundBrush}"
                            BorderBrush="{StaticResource BorderDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Height="46">
                        <ComboBox x:Name="StatusCombo"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  FontSize="14"
                                  VerticalAlignment="Center"
                                  Padding="8,0">
                            <ComboBoxItem Content="Active" Tag="Active"/>
                            <ComboBoxItem Content="Suspended" Tag="Suspended"/>
                            <ComboBoxItem Content="Graduated" Tag="Graduated"/>
                        </ComboBox>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- BUTTONS -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="Cancel"
                    Style="{StaticResource SecondaryButton}"
                    Click="CancelBtn_Click"/>

            <Button Grid.Column="2"
                    x:Name="SaveBtn"
                    Content="Save Student"
                    Style="{StaticResource PrimaryButton}"
                    Click="SaveBtn_Click"/>
        </Grid>

    </Grid>
</Window>