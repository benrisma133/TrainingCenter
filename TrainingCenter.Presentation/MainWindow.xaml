<Window x:Class="TrainingCenter.Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="TrainingCenter - Style Test"
        Height="500" Width="800"
        Background="{StaticResource AppBackgroundBrush}"
        WindowStartupLocation="CenterScreen">

    <StackPanel Margin="40" VerticalAlignment="Center">

        <!-- Title -->
        <TextBlock Text="Style Test"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   Margin="0,0,0,30"/>

        <!-- Buttons Row -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">

            <Button Content="Primary Button"
                    Style="{StaticResource PrimaryButton}"
                    Width="160"
                    Margin="0,0,12,0"/>

            <Button Content="Secondary Button"
                    Style="{StaticResource SecondaryButton}"
                    Width="160"
                    Margin="0,0,12,0"/>

            <Button Content="Danger Button"
                    Style="{StaticResource DangerButton}"
                    Width="160"/>

        </StackPanel>

        <!-- Card Test -->
        <Border Style="{StaticResource CardBorder}"
                Effect="{StaticResource CardShadow}"
                Margin="0,10">
            <StackPanel>
                <TextBlock Text="Card Title"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="0,0,0,8"/>
                <TextBlock Text="This is a card component with dark background and border."
                           FontSize="14"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
        </Border>

        <!-- Status Colors -->
        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
            <Border Background="{StaticResource SuccessBrush}" 
                    CornerRadius="6" Padding="12,6" Margin="0,0,8,0">
                <TextBlock Text="Success" Foreground="White" FontWeight="SemiBold"/>
            </Border>
            <Border Background="{StaticResource WarningBrush}" 
                    CornerRadius="6" Padding="12,6" Margin="0,0,8,0">
                <TextBlock Text="Warning" Foreground="White" FontWeight="SemiBold"/>
            </Border>
            <Border Background="{StaticResource ErrorBrush}" 
                    CornerRadius="6" Padding="12,6" Margin="0,0,8,0">
                <TextBlock Text="Error" Foreground="White" FontWeight="SemiBold"/>
            </Border>
            <Border Background="{StaticResource AccentBrush}" 
                    CornerRadius="6" Padding="12,6">
                <TextBlock Text="Info" Foreground="White" FontWeight="SemiBold"/>
            </Border>
        </StackPanel>

    </StackPanel>
</Window>